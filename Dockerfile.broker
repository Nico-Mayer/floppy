# Builds only the rendezvous broker (the standalone ./broker module) — not the
# Tauri app. It serves both modes: /ws (code-mailbox for quick share) and /fp
# (fingerprint routing for trusted devices).
#
# Deploy on Railway: railway.json points here. Railway injects $PORT and
# terminates TLS, so the broker serves plain ws and clients dial wss://.

FROM golang:1.26 AS build
WORKDIR /src

# Cache module downloads on go.mod/go.sum only.
COPY broker/go.mod broker/go.sum ./
RUN go mod download

COPY broker/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /broker .

# Static binary → distroless. Non-root, no shell, minimal surface.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /broker /broker
# Documentation only; Railway injects $PORT and the broker honours it.
EXPOSE 8080
ENTRYPOINT ["/broker"]
