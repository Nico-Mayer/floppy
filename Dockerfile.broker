# Builds only the rendezvous broker (cmd/broker) — not the Wails app. The build
# graph is cmd/broker → internal/broker → internal/pairing, so the frontend and
# the //go:embed in root main.go are never touched.
#
# Deploy on Railway: railway.json points the Dockerfile path here; Railway sets
# $PORT and terminates TLS, so the broker serves plain ws and clients use wss://.

FROM golang:1.26 AS build
WORKDIR /src

# Cache module downloads on go.mod/go.sum only.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /broker ./cmd/broker

# Static binary → distroless. Non-root, no shell, minimal surface.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /broker /broker
# Documentation only; Railway injects $PORT and the broker honours it.
EXPOSE 8080
ENTRYPOINT ["/broker"]
