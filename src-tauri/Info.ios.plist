<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated iOS Info.plist by Tauri at build.

  UIFileSharingEnabled + LSSupportsOpeningDocumentsInPlace surface the app's
  Documents dir (where received files land, see `resolve_dest_root`) in the Files
  app under On My iPhone -> Floppy, so a user can actually reach their receives.

  NSLocalNetworkUsageDescription lets iroh hole-punch a direct LAN path instead
  of silently degrading to relay-only. NSPhotoLibraryUsageDescription gates the
  photo picker. Both must sit here rather than in the generated plist so they
  survive an `ios init` regeneration.
-->
<plist version="1.0">
<dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Floppy connects directly to nearby devices on your local network to transfer files without a relay.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Floppy needs access to your photo library so you can pick photos and videos to send.</string>
</dict>
</plist>
