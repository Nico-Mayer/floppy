{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "floppy",
  "version": "0.1.0",
  "identifier": "com.nimayer.floppy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Floppy",
        "width": 500,
        "height": 820,
        "minWidth": 500,
        "minHeight": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 27 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["floppy"] }],
      "desktop": {
        "schemes": ["floppy"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "5KC9HY8QXS"
    }
  }
}
