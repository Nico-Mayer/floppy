{
  // Zed *replaces* file_scan_exclusions rather than merging, so the nine
  // upstream defaults are repeated here — dropping them would silently start
  // scanning .git and friends.
  //
  // The entries after them are this repo's generated/vendored trees.
  // frontend/node_modules alone is ~254 MB across ~31k files, which is the
  // only thing here big enough to matter; build/ is deliberately NOT excluded
  // (it is 75 tracked files of real source: the Taskfiles, config.yml, the
  // Android/iOS manifests and icons).
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/dist",
    "**/bin",
    "**/.task"
  ]
}
