      "id": "file:src-tauri/src/pairing/broker.rs",
      "type": "file",
      "name": "broker.rs",
      "filePath": "src-tauri/src/pairing/broker.rs",
      "summary": "Fingerprint-broker WebSocket client that registers this device by its public key and relays signed pairing/transfer signals to peers routed by fingerprint, with automatic reconnect and backoff.",
      "tags": ["service", "networking", "websocket", "signalling", "pairing"],
      "complexity": "moderate",
      "languageNotes": "Uses tokio-tungstenite split streams and an unbounded mpsc channel to decouple send/receive from the reconnect loop."
    },
    {
      "id": "file:src-tauri/src/pairing/identity.rs",
      "type": "file",
      "name": "identity.rs",
      "filePath": "src-tauri/src/pairing/identity.rs",
      "summary": "Device cryptographic identity: an Ed25519 signing key plus an X25519 key-exchange key, persisted atomically to disk, exposing fingerprints, signing/verification, ECDH shared secrets, and broker registration proofs.",
      "tags": ["data-model", "cryptography", "identity", "serialization", "validation"],
      "complexity": "complex",
      "languageNotes": "Ed25519 (ed25519-dalek) for signatures and X25519 (x25519-dalek) for ECDH; keys are seeded via getrandom and stored as a DiskIdentity serde struct with 0600 permissions."
    },
    {
      "id": "file:src-tauri/src/pairing/mod.rs",
      "type": "file",
      "name": "mod.rs",
      "filePath": "src-tauri/src/pairing/mod.rs",
