      "tags": ["barrel", "entry-point", "module", "pairing"],
      "complexity": "simple",
      "languageNotes": "Rust module barrel using `pub mod` declarations and a single `pub use` re-export."
    },
    {
      "id": "file:src-tauri/src/pairing/offer.rs",
      "type": "file",
      "name": "offer.rs",
      "filePath": "src-tauri/src/pairing/offer.rs",
      "summary": "Signed transfer-handshake messages (Offer, Response, Completion) carrying an iroh ticket, with canonical byte encoding, signing helpers on Identity, and trust+signature verification against the trust store.",
      "tags": ["data-model", "cryptography", "validation", "serialization", "protocol"],
      "complexity": "complex",
      "languageNotes": "Deterministic length-prefixed signing bytes ensure signatures cover the exact ticket, guarding against node substitution attacks; includes an inline test module."
    },
    {
      "id": "file:src-tauri/src/pairing/sas.rs",
      "type": "file",
      "name": "sas.rs",
      "filePath": "src-tauri/src/pairing/sas.rs",
      "summary": "Derives a six-digit short authentication string (SAS) from the ECDH shared secret via HKDF-SHA256, used so two devices can visually compare a code during code pairing.",
      "tags": ["cryptography", "utility", "pairing", "validation"],
      "complexity": "simple",
      "languageNotes": "HKDF-SHA256 expansion with a domain-separation info string (\"floppy/sas\") producing a zero-padded 6-digit code."
    },
    {
      "id": "file:src-tauri/src/pairing/self_name.rs",
