<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="floppy"
        Arguments=""
        InstallLocation="C:\Program Files\Nico Mayer\Floppy">
    </Installer>
    <PackageInformation
        PackageName="Floppy"
        PackageDisplayName="Floppy"
        PublisherName="CN=Nico Mayer"
        PublisherDisplayName="Nico Mayer"
        Version="0.1.0.0"
        PackageDescription="Send and receive files device to device">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.nico-mayer.floppy"
                Description="Send and receive files device to device"
                DisplayName="Floppy"
                ExecutableName="floppy"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Floppy</DisplayName>
            <PublisherDisplayName>Nico Mayer</PublisherDisplayName>
            <Description>Send and receive files device to device</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="floppy.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
